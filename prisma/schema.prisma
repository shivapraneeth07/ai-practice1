generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  phone          String?
  passwordHash   String
  role           String   @default("SEEKER")
  suspended      Boolean  @default(false)
  emailVerified  Boolean  @default(false)
  phoneVerified  Boolean  @default(false)
  identityVerified Boolean @default(false)
  profile        Profile?
  properties     Property[]
  favorites      Favorite[]
  searchHistory  SearchHistory[]
  savedSearches  SavedSearch[]
  conversations  Conversation[] @relation("ConversationSeeker")
  ownerConversations Conversation[] @relation("ConversationOwner")
  sentMessages   Message[]
  visitRequests  VisitRequest[]
  notifications  Notification[]
  reports        Report[]
  propertyViews  PropertyView[]
  passwordResets PasswordResetToken[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([role])
}

model Profile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarUrl      String?
  bio            String?
  responseRate   Int      @default(0)
  memberSince    DateTime @default(now())
  preferredAreas String   @default("")
  preferredBudgetMin Int   @default(0)
  preferredBudgetMax Int   @default(0)
  preferredBedrooms String?
}

model Property {
  id               String   @id @default(cuid())
  ownerId          String
  owner            User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title            String
  type             String
  bedroomType      String
  bedrooms         Int
  bathrooms        Int
  rent             Int
  deposit          Int
  maintenance      Int      @default(0)
  availableFrom    DateTime
  furnishing       String
  city             String
  area             String
  locality         String
  address          String
  pincode          String?
  lat              Float?
  lng              Float?
  sqft             Int?
  floor            Int?
  totalFloors      Int?
  facing           String?
  age              Int?
  description      String?
  status           String   @default("PENDING")
  verified         Boolean  @default(false)
  viewCount        Int      @default(0)
  favoriteCount    Int      @default(0)
  images           PropertyImage[]
  amenities        PropertyAmenity[]
  rules            PropertyRuleModel[]
  favorites        Favorite[]
  conversations    Conversation[]
  visitRequests    VisitRequest[]
  reports          Report[]
  views            PropertyView[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([city])
  @@index([locality])
  @@index([rent])
  @@index([bedrooms])
  @@index([type])
  @@index([furnishing])
  @@index([status])
  @@index([ownerId])
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String
  order      Int      @default(0)
  createdAt  DateTime @default(now())
}

model PropertyAmenity {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity    String

  @@unique([propertyId, amenity])
}

model PropertyRuleModel {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rule       String

  @@unique([propertyId, rule])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
  @@index([userId])
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  query     String
  filters   String   @default("{}")
  createdAt DateTime @default(now())

  @@index([userId])
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  query     String
  filters   String   @default("{}")
  createdAt DateTime @default(now())

  @@index([userId])
}

model Conversation {
  id         String    @id @default(cuid())
  seekerId   String
  seeker     User      @relation("ConversationSeeker", fields: [seekerId], references: [id], onDelete: Cascade)
  ownerId    String
  owner      User      @relation("ConversationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  messages   Message[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([seekerId, ownerId, propertyId])
  @@index([ownerId])
  @@index([seekerId])
  @@index([propertyId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model VisitRequest {
  id             String   @id @default(cuid())
  propertyId     String
  property       Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  seekerId       String
  seeker         User     @relation(fields: [seekerId], references: [id], onDelete: Cascade)
  date           DateTime
  time           String
  message        String?
  status         String   @default("PENDING")
  ownerResponse  String?
  alternateDate  DateTime?
  alternateTime  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([propertyId])
  @@index([seekerId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
}

model Report {
  id          String   @id @default(cuid())
  reporterId  String
  reporter    User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reason      String
  description String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([propertyId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model PropertyView {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([propertyId])
}
