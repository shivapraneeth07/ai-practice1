# Base URL of the deployed app (set to https://your-project.vercel.app in production)
NEXTAUTH_URL=http://localhost:3000
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-here

# PostgreSQL connection string (Vercel Postgres / Neon / Supabase)
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# Local dev: drop the ?sslmode=require suffix (local Postgres usually has TLS disabled), e.g.
# postgresql://postgres:postgres@localhost:5432/rentease
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# Vercel Blob store token (from Vercel dashboard -> Storage -> Blob)
# Required for image uploads in production.
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token

# Google OAuth (optional). Required only for "Continue with Google" login/signup.
# Create credentials at https://console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID (Web app).
# Authorized redirect URI: https://<your-app>.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret